<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://cibseven.org/bpmn20/reference"
             id="adHocSubProcessExpanded">
  <process id="adHocExpanded" isExecutable="false">
    <startEvent id="start" />
    <sequenceFlow id="toScope" sourceRef="start" targetRef="handleIncident" />
    <adHocSubProcess id="handleIncident" name="Handle incident">
      <userTask id="callCustomer" name="Call customer" />
      <userTask id="checkLogs" name="Check logs" />
      <userTask id="orderSparePart" name="Order spare part" />
      <completionCondition xsi:type="tFormalExpression">${execution.hasVariable('resolved') and resolved}</completionCondition>
    </adHocSubProcess>
    <sequenceFlow id="fromScope" sourceRef="handleIncident" targetRef="closeIncident" />
    <userTask id="closeIncident" name="Close incident" />
    <sequenceFlow id="toEnd" sourceRef="closeIncident" targetRef="end" />
    <endEvent id="end" />
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="adHocExpanded">
      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <omgdc:Bounds x="100" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_handleIncident" bpmnElement="handleIncident" isExpanded="true">
        <omgdc:Bounds x="186" y="80" width="240" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_callCustomer" bpmnElement="callCustomer">
        <omgdc:Bounds x="246" y="110" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_checkLogs" bpmnElement="checkLogs">
        <omgdc:Bounds x="246" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_orderSparePart" bpmnElement="orderSparePart">
        <omgdc:Bounds x="246" y="290" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_closeIncident" bpmnElement="closeIncident">
        <omgdc:Bounds x="476" y="200" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_end" bpmnElement="end">
        <omgdc:Bounds x="646" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_toScope" bpmnElement="toScope">
        <omgdi:waypoint x="136" y="240" />
        <omgdi:waypoint x="186" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_fromScope" bpmnElement="fromScope">
        <omgdi:waypoint x="426" y="240" />
        <omgdi:waypoint x="476" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_toEnd" bpmnElement="toEnd">
        <omgdi:waypoint x="596" y="240" />
        <omgdi:waypoint x="646" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
